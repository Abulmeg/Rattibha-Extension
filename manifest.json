{
  "manifest_version": 3,
  "name": "Rattibha Learn",
  "version": "0.12.0",
  "description": "Find JUST eLearning files faster and download DOCX/PPTX materials as PDFs directly from courses.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://elearn.just.edu.jo/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://elearn.just.edu.jo/current/my/courses.php*",
        "https://elearn.just.edu.jo/current/course/view.php*"
      ],
      "js": [
        "preflight.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://elearn.just.edu.jo/current/*"
      ],
      "js": [
        "vendor/jszip.min.js",
        "pdf-generator.js",
        "file-tools.js",
        "inline-pdf.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "icons/mark.svg",
        "icons/mark-white.svg"
      ],
      "matches": [
        "https://elearn.just.edu.jo/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Rattibha Learn",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
